# ============================================================
# PROJECT MORNINGSTAR — All-Might C Prime Bot
# Environment Variable Configuration Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to version control.
# The .env file is already listed in .gitignore.

# ----------------------------------------------------------
# TELEGRAM (Required)
# ----------------------------------------------------------
BOT_TOKEN=your_telegram_bot_token_here

# ----------------------------------------------------------
# BINANCE API (Required for account balance display and live
# market data. Not required for paper trading only.)
#
# IMPORTANT: When creating your Binance API key:
#   - Enable "Read Info" permission ONLY for safety.
#   - Enable "Spot & Margin Trading" only when live trading
#     is explicitly enabled in a future phase.
#   - NEVER enable "Withdrawal" or "Universal Transfer".
#   - Restrict the key to trusted IP addresses if possible.
# ----------------------------------------------------------
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ----------------------------------------------------------
# BINANCE BASE URL (Optional — defaults shown below)
# Change to https://testnet.binance.vision for Binance Testnet
# ----------------------------------------------------------
BINANCE_BASE_URL=https://api.binance.com

# ----------------------------------------------------------
# LIVE TRADING SWITCH
# Set to True ONLY when explicitly approved for live trading.
# Default MUST remain False for paper-trading-only operation.
# Changing this to True without full Phase 3 completion and
# explicit approval is dangerous and not supported.
# ----------------------------------------------------------
LIVE_TRADING_ENABLED=False

# ----------------------------------------------------------
# DRY_RUN MODE (Phase 3.2b)
# Default MUST remain True for safe operation.
# While True, the execution layer (BinanceService.place_order)
# NEVER sends a real order to Binance — it only simulates and
# logs the intended order (symbol, side, quantity, entry/current
# price, stop loss, take profit). This is an additional safety
# layer on top of LIVE_TRADING_ENABLED, not a replacement for it.
# Only set to False in a fully reviewed, explicitly approved
# live-trading configuration.
# ----------------------------------------------------------
DRY_RUN=True
